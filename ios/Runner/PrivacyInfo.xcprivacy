	<key>NSPrivacyAccessedAPITypes</key>
	<dict>
		<key>NSPrivacyAccessedAPICategoryFileTimestamp</key>
		<array>
			<string>Accessing file timestamps to track file modification history for user convenience</string>
		</array>
