		<array>
			<string>Retrieving system boot time to optimize app performance based on device uptime</string>
		</array>
		<key>NSPrivacyAccessedAPICategoryUserDefaults</key>
		<array>
			<string>Accessing UserDefaults to store user preferences and settings securely</string>
		</array>
		<key>NSPrivacyAccessedAPICategoryDiskSpace</key>
		<array>
			<string>Checking disk space availability to prevent data loss and provide storage management features</string>
			</array>
		</dict>
	</dict>

